{
  "name": "carb-bot",
  "version": "1.0.0",
  "description": "Telegram bot for tracking daily carbohydrate portions",
  "main": "src/index.js",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "set NODE_ENV=test && nodemon src/index.js",
    "dashboard": "node generate-dashboard.js",
    "migrate": "node --use-system-ca migrate-to-mongo.js"
  },
  "dependencies": {
    "dotenv": "^16.4.0",
    "mongodb": "^6.21.0",
    "node-cron": "^3.0.3",
    "telegraf": "^4.16.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
